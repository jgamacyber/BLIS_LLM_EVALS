# Chave da OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=coloque_sua_api_aqui

# Modelo que atua como JUIZ.
# Mantenha DIFERENTE do modelo avaliado: usar o mesmo para gerar e julgar
# introduz autopreferência (alerta do G-Eval, Liu et al., 2023).
JUIZ_MODEL=openai/gpt-4o-mini

# Modelo que produziu as respostas sendo avaliadas (só informativo aqui).
MODELO_AVALIADO=openai/gpt-4o-mini

# Embeddings (usados pela answer relevance do RAGAS)
EMBEDDING_MODEL=openai/text-embedding-3-small

TEMPERATURE=0.0
MAX_TOKENS=800

# G-Eval: ponderação por probabilidade
GEVAL_LOGPROBS=true
GEVAL_AMOSTRAS=8
GEVAL_ESCALA_MAX=5

# RAGAS: perguntas reversas geradas para a answer relevance (n da Eq. 1)
RAGAS_N_PERGUNTAS=3

# PPI: 0.05 = intervalos de 95% (como no ARES)
PPI_ALPHA=0.05
